{
  "i18n": true,
  "type": "panel",
  "items": {
    "_credentials": {
      "type": "panel",
      "items": {
        "username": {
          "type": "text",
          "label": "lblUsername",
          "sm": 12,
          "md": 4
        },
        "password": {
          "type": "password",
          "label": "lblPassword",
          "sm": 12,
          "md": 4
        },
        "synctime": {
          "type": "cron",
          "simple": true,
          "label": "lblSynctime",
          "sm": 12,
          "md": 4
        }
      }
    },
    "_divider1": {
      "type": "divider"
    },
    "checkboxGrid": {
      "type": "panel",
      "items": {
        "_fields1": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "isin": { "type": "checkbox", "label": "lblIsin" },
            "symbol": { "type": "checkbox", "label": "lblSymbol" },
            "name": { "type": "checkbox", "label": "lblName" },
            "currency": { "type": "checkbox", "label": "lblCurrency" },
            "country": { "type": "checkbox", "label": "lblCountry" }
          }
        },
        "_fields2": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "last": { "type": "checkbox", "label": "lblLast" },
            "low": { "type": "checkbox", "label": "lblLow" },
            "high": { "type": "checkbox", "label": "lblHigh" },
            "prevDay": { "type": "checkbox", "label": "lblPrevDay" },
            "performance": { "type": "checkbox", "label": "lblPerformance" }
          }
        },
        "_fields3": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "w52High": { "type": "checkbox", "label": "lblW52High" },
            "w52HighDate": { "type": "checkbox", "label": "lblW52HighDate" },
            "w52low": { "type": "checkbox", "label": "lblW52low" },
            "w52LowDate": { "type": "checkbox", "label": "lblW52LowDate" },
            "w52Close": { "type": "checkbox", "label": "lblW52Close" }
          }
        }
      }
    },
    "_divider2": {
      "type": "divider"
    },
    "_calculation": {
      "type": "panel",
      "items": {
        "regression": {
          "type": "checkbox",
          "label": "lblRegression",
          "sm": 12,
          "md": 4
        },
        "average": {
          "type": "checkbox",
          "label": "lblAverage",
          "sm": 12,
          "md": 4
        },
        "limitLow": {
          "type": "checkbox",
          "label": "lblLimitLow",
          "sm": 12,
          "md": 4
        },
        "limitHigh": {
          "type": "checkbox",
          "label": "lblLimitHigh",
          "sm": 12,
          "md": 4
        }
      }
    }
  }
}
