{
  "i18n": true,
  "type": "tabs",
  "items": {
    "_generalTab": {
      "label": "lblGeneral",
      "type": "panel",
      "items": {
        "_credentials": {
          "type": "panel",
          "items": {
            "username": {
              "type": "text",
              "label": "lblUsername",
              "sm": 6,
              "md": 4
            },
            "password": {
              "type": "password",
              "label": "lblPassword",
              "sm": 6,
              "md": 4
            },
            "syncTime": {
              "type": "cron",
              "simple": true,
              "label": "lblSyncTime",
              "sm": 6,
              "md": 4
            }
          }
        },
        "_divider1": {
          "type": "divider",
          "height": 2
        },
        "_fieldsText": {
            "newLine": true,
            "type": "staticText",
            "text": "lblFields"
        },
        "_fieldsGrid": {
          "type": "panel",
          "items": {
            "_fields1": {
              "type": "panel",
              "sm": 6,
              "md": 4,
              "items": {
                "isinEnabled": { "type": "checkbox", "label": "lblIsin" },
                "symbolEnabled": { "type": "checkbox", "label": "lblSymbol" },
                "nameEnabled": { "type": "checkbox", "label": "lblName" },
                "currencyEnabled": { "type": "checkbox", "label": "lblCurrency" },
                "countryEnabled": { "type": "checkbox", "label": "lblCountry" }
              }
            },
            "_fields2": {
              "type": "panel",
              "sm": 6,
              "md": 4,
              "items": {
                "lastEnabled": { "type": "checkbox", "label": "lblLast", "default": true, "disabled": "true" },
                "highEnabled": { "type": "checkbox", "label": "lblHigh" },
                "lowEnabled": { "type": "checkbox", "label": "lblLow" },
                "prevDayEnabled": { "type": "checkbox", "label": "lblPrevDay" },
                "performanceEnabled": { "type": "checkbox", "label": "lblPerformance" }
              }
            },
            "_fields3": {
              "type": "panel",
              "sm": 6,
              "md": 4,
              "items": {
                "w52CloseEnabled": { "type": "checkbox", "label": "lblW52Close" },
                "w52HighEnabled": { "type": "checkbox", "label": "lblW52High" },
                "w52HighDateEnabled": { "type": "checkbox", "label": "lblW52HighDate" },
                "w52LowEnabled": { "type": "checkbox", "label": "lblW52Low" },
                "w52LowDateEnabled": { "type": "checkbox", "label": "lblW52LowDate" }
              }
            }
          }
        },
        "_divider2": {
          "type": "divider",
          "height": 2
        },
        "_additionalGrid": {
          "type": "panel",
          "items": {
            "historyInstance": {
              "type": "instance",
              "adapter": "_dataSources",
              "label": "lblHistoryInstance",
              "sm": 6,
              "md": 4
            },
            "_calculation": {
              "type": "panel",
              "sm": 6,
              "md": 4,
              "items": {
                "_calculationText": { "type": "staticText", "text": "lblCalculation" },
                "calculateRegressionEnabled": { "type": "checkbox", "label": "lblCalculateRegressionEnabled" },
                "calculateAverageEnabled": { "type": "checkbox", "label": "lblCalculateAverageEnabled" }
              }
            }
          }
        }
      }
    },
    "_watchTab": {
      "label": "lblWatch",
      "type": "panel",
      "items": {
        "notificationInstance": {
          "type": "instance",
          "label": "lblNotificationInstance",
          "adapter": "",
          "adapters": [
            "telegram",
            "pushover",
            "pushsafer",
            "email",
            "whatsapp-cmb",
            "signal-cmb",
            "matrix",
            "discord"
          ],
          "sm": 6,
          "md": 3
        },
        "_limitAlert": {
          "type": "panel",
          "sm": 6,
          "md": 3,
          "items": {
            "_limitAlertText": { "type": "staticText", "text": "lblLimitAlert" },
            "limitHighEnabled": { "type": "checkbox", "label": "lblLimitHighEnabled" },
            "limitLowEnabled": { "type": "checkbox", "label": "lblLimitLowEnabled" }
          }
        },
        "_regressionAlert": {
          "type": "panel",
          "sm": 6,
          "md": 3,
          "items": {
            "_regressionAlertText": { "type": "staticText", "text": "lblRegressionAlert" },
            "regressionHighEnabled": { "type": "checkbox", "label": "lblRegressionHighEnabled" },
            "regressionLowEnabled": { "type": "checkbox", "label": "lblRegressionLowEnabled" }
          }
        },
        "_averageAlert": {
          "type": "panel",
          "sm": 6,
          "md": 3,
          "items": {
            "_averageAlertText": { "type": "staticText", "text": "lblAverageAlert" },
            "averageHighEnabled": { "type": "checkbox", "label": "lblAverageHighEnabled" },
            "averageLowEnabled": { "type": "checkbox", "label": "lblAverageLowEnabled" }
          }
        },
        "isinsTable": {
          "newLine": true,
          "type": "table",
          "export": true,
          "import": true,
          "sm": 12,
          "md": 12,
          "uniqueColumns": ["isin"],
          "items": [
              {
                  "type": "text",
                  "attr": "isin",
                  "title": "lblIsin",
                  "sort": true,
                  "width": "15%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "limitHigh",
                  "title": "lblLimitHigh",
                  "sort": true,
                  "width": "10%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "limitLow",
                  "title": "lblLimitLow",
                  "sort": true,
                  "width": "10%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "regressionHigh",
                  "title": "lblRegressionHigh",
                  "sort": true,
                  "width": "10%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "regressionLow",
                  "title": "lblRegressionLow",
                  "sort": true,
                  "width": "10%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "averageHigh",
                  "title": "lblAverageHigh",
                  "sort": true,
                  "width": "10%"
              },
              {
                  "type": "number",
                  "min": 0,
                  "default": 0,
                  "attr": "averageLow",
                  "title": "lblAverageLow",
                  "sort": true,
                  "width": "10%"
              }
            ]
        }
      }
    }
  }
}
