    "credentialsRow": {
      "type": "panel",
      "label": "API",
      "items": {
        "username": {
          "type": "text",
          "label": "Username",
          "sm": 12,
          "md": 4
        },
        "password": {
          "type": "password",
          "label": "Password",
          "sm": 12,
          "md": 4
        },
        "synctime": {
          "type": "cron",
          "simple": true,
          "label": "Sync time",
          "sm": 12,
          "md": 4
        }
      }
    },
    "divider": {
      "type": "divider"
    },
    "checkboxGrid": {
      "type": "panel",
      "label": "Fields selection",
      "items": {
        "row1": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "isin": { "type": "checkbox", "label": "isin" },
            "symbol": { "type": "checkbox", "label": "symbol" },
            "name": { "type": "checkbox", "label": "name" },
            "currency": { "type": "checkbox", "label": "currency" },
            "country": { "type": "checkbox", "label": "country" }
          }
        },
        "row2": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "last": { "type": "checkbox", "label": "last" },
            "low": { "type": "checkbox", "label": "low" },
            "high": { "type": "checkbox", "label": "high" },
            "prevDay": { "type": "checkbox", "label": "prevDay" },
            "percent": { "type": "checkbox", "label": "percent" }
          }
        },
        "row3": {
          "type": "panel",
          "sm": 12,
          "md": 3,
          "items": {
            "w52High": { "type": "checkbox", "label": "w52High" },
            "w52HighDate": { "type": "checkbox", "label": "w52HighDate" },
            "w52low": { "type": "checkbox", "label": "w52low" },
            "w52low": { "type": "checkbox", "label": "w52LowDate" },
            "w52Close": { "type": "checkbox", "label": "w52Close" }
          }
        }
      }
    },
    "divider": {
      "type": "divider"
    },
    "calculationRow": {
      "type": "panel",
      "label": "Calculation",
      "items": {
        "average": {
          "type": "checkbox",
          "label": "Average",
          "sm": 12,
          "md": 4
